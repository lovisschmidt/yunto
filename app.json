{
  "expo": {
    "name": "Yunto",
    "slug": "yunto",
    "platforms": ["android"],
    "plugins": [
      "expo-audio",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#232323",
          "image": "./assets/images/splash-icon.png",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 200
        }
      ]
    ],
    "icon": "./assets/images/app-icon.png",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-adaptive.png",
        "backgroundColor": "#1A1348ff"
      }
    }
  }
}
